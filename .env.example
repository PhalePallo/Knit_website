# EmailJS Configuration
# Get these values from https://www.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# Google Gemini AI API (Optional - for AI features)
# Get your API key from https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Analytics (Optional)
# Get your tracking ID from Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Hotjar (Optional - for user analytics)
# Get your site ID from Hotjar dashboard
VITE_HOTJAR_ID=your_hotjar_id_here

# Sentry Error Tracking (Optional)
# Get your DSN from Sentry dashboard
VITE_SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_AGE_GATE=false

# Environment
NODE_ENV=development
